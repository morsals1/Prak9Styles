<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="AppBackground" Color="#1F2937"/>
    <SolidColorBrush x:Key="AppForeground" Color="#E5E7EB"/>

    <SolidColorBrush x:Key="ButtonBackground" Color="#6366F1"/>
    <SolidColorBrush x:Key="ButtonHover" Color="#4F46E5"/>
    <SolidColorBrush x:Key="ButtonPressed" Color="#4338CA"/>
    <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ButtonBorder" Color="#6366F1"/>

    <SolidColorBrush x:Key="AddButtonBackground" Color="#10B981"/>
    <SolidColorBrush x:Key="AddButtonHover" Color="#059669"/>
    <SolidColorBrush x:Key="AddButtonPressed" Color="#047857"/>

    <SolidColorBrush x:Key="DeleteButtonBackground" Color="#F43F5E"/>
    <SolidColorBrush x:Key="DeleteButtonHover" Color="#E11D48"/>
    <SolidColorBrush x:Key="DeleteButtonPressed" Color="#BE123C"/>

    <SolidColorBrush x:Key="TextBoxBackground" Color="#374151"/>
    <SolidColorBrush x:Key="TextBoxBorder" Color="#94A3B8"/>
    <SolidColorBrush x:Key="GroupBoxBorder" Color="#64748B"/>
    <SolidColorBrush x:Key="ListViewBorder" Color="#64748B"/>

</ResourceDictionary>