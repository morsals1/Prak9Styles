<Page x:Class="WpfP7.Pages.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="RegisterPage"
      Background="{DynamicResource AppBackground}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Width="400" Style="{StaticResource CenterStackPanel}">
            <TextBlock Text="Регистрация доктора" FontSize="20" HorizontalAlignment="Center"/>

            <Label Content="Имя"/>
            <TextBox x:Name="NameTextBox" Text="{Binding CurrentDoctor.Name, Mode=TwoWay}"/>

            <Label Content="Фамилия"/>
            <TextBox x:Name="LastNameTextBox" Text="{Binding CurrentDoctor.LastName, Mode=TwoWay}"/>

            <Label Content="Отчество"/>
            <TextBox x:Name="MiddleNameTextBox" Text="{Binding CurrentDoctor.MiddleName, Mode=TwoWay}"/>

            <Label Content="Специализация"/>
            <TextBox x:Name="SpecTextBox" Text="{Binding CurrentDoctor.Specification, Mode=TwoWay}"/>

            <Label Content="Пароль"/>
            <PasswordBox x:Name="PasswordBox"/>

            <Label Content="Подтверждение пароля"/>
            <PasswordBox x:Name="ConfirmPasswordBox"/>

            <StackPanel Orientation="Horizontal" Style="{StaticResource HorizontalStackPanel}">
                <Button Style="{StaticResource AddButton}" 
                        Content="Зарегистрировать" 
                        Click="RegisterButton_Click"/>
                <Button Style="{StaticResource StandardButton}" 
                        Content="Назад" 
                        Click="BackButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>